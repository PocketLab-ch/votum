# Vollständige Liste aller Umgebungsvariablen. Jede mit sinnvoller Voreinstellung
# ausser den Zugangsdaten.

# ── Datenbank ──────────────────────────────────────────────────────────────
# Die Anwendung läuft unter einer eingeschränkten Rolle: Sie unterliegt dem
# Zeilenschutz und darf auf dem Verlauf weder ändern noch löschen (AD-5, AD-6).
# Mit einer Superuser-Verbindung wären beide Regeln vorhanden, aber wirkungslos.
DATABASE_URL=postgres://versammlung_app:entwicklung@localhost:5434/versammlung

# Migrationen brauchen eine eigene, privilegierte Rolle (AD-6).
DATABASE_MIGRATION_URL=postgres://versammlung:entwicklung@localhost:5434/versammlung

POSTGRES_PASSWORD=entwicklung
APP_DB_PASSWORD=entwicklung

# ── Betrieb ────────────────────────────────────────────────────────────────
# Nur zur Kennzeichnung der Zeitquelle im Verlauf. Der Betriebszustand selbst
# wird aus der Erreichbarkeit der Dienste ermittelt, nicht hierüber gesetzt.
VERSAMMLUNG_OFFLINE=false

# ── Dateiablage ────────────────────────────────────────────────────────────
# Nutzniessungsverträge, Anträge, später das Abschlusspaket. Der Dateiname ist
# die Prüfsumme des Inhalts; Dateien werden nur angefügt, nie überschrieben
# (AD-17). Zusammen mit der Datenbank zu sichern, nie getrennt.
VERSAMMLUNG_DATEIEN=./daten/dateien

# ── Anmeldung über Authentik (freiwillig, Story 4.1) ───────────────────────
# Bleibt eines der drei Felder leer, erscheint der Knopf gar nicht und die
# lokale Anmeldung ist der vorgesehene Weg. Ist Authentik eingerichtet aber
# nicht erreichbar, weicht die Anmeldeseite mit Hinweis auf die lokale aus, und
# die Nutzung dieser Rückfallebene steht im Verlauf (AD-9).
#
# In Authentik einzurichten: Provider vom Typ OAuth2/OpenID, Client-Typ
# «Confidential», Redirect-URI  https://<host>/anmelden/authentik/zurueck
# Ein Konto entsteht dabei NICHT von selbst: Wer eine Versammlung führen darf,
# entscheidet die Bewirtschaftung über `scripts/benutzer-anlegen.mjs`. Beim
# ersten Anmelden wird die Kennung mit dem gleichnamigen Konto verknüpft.
# Herkunft der Anfragen — für die zweite Anmeldesperre.
#
# Ohne Angabe gilt die Adresse der Verbindung; richtig im Direktbetrieb, etwa
# auf einem Notebook im Versammlungsraum. Steht die Anwendung hinter einem
# Reverse Proxy, ist das die Adresse des Proxys — dann gehört hier
# `x-forwarded-for` hinein, sonst träfe die Sperre alle zugleich.
#
# **Nur eintragen, wenn ein Proxy die Zeile tatsächlich setzt.** Sie ist frei
# wählbar für jeden, der die Anwendung direkt erreicht; wird sie ungeprüft
# ausgewertet, wechselt ein Angreifer seine Herkunft mit jedem Versuch.
#
# **Angenommen ist genau ein Proxy**, der seine Sicht hinten anhängt (nginx und
# Nginx Proxy Manager: `$proxy_add_x_forwarded_for`). Gezählt wird der
# hinterste Eintrag; was der Aufrufer vorne mitschickt, zählt nicht. Stehen
# zwei Proxys hintereinander, wäre der hinterste Eintrag der vordere Proxy.
VERSAMMLUNG_ADRESSKOPFZEILE=

AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# ── Zeitstempel nach RFC 3161 ──────────────────────────────────────────────
#
# **Auch das lässt sich seit dem 14.08.2026 in der Anwendung einrichten** und
# ist dort einfacher: Der Prüfknopf holt einen Testzeitstempel und bietet den
# Fingerabdruck des Ausstellers zum Anheften an, statt ihn von Hand mit drei
# `openssl`-Aufrufen zu beschaffen. Die Werte hier sind der Rückfall.
# Bezeugt von aussen, dass das Siegel eines Abschlusspakets zu einem bestimmten
# Zeitpunkt bereits vorlag. Ohne Eintrag wird versiegelt, aber nicht bezeugt —
# das Siegel gilt trotzdem, die Lücke steht sichtbar am Paket und auf der
# Übersicht.
#
# Für den Ernstfall gehört hier ein Dienst hin, dem eine Gegenpartei glaubt.
# freetsa.org ist frei und für Entwicklung und Abnahme gut genug.
VERSAMMLUNG_ZEITSTEMPEL_URL=
VERSAMMLUNG_ZEITSTEMPEL_NAME=

# **Angeheftete Zertifikate.** SHA-256-Fingerabdrücke der Signaturzertifikate,
# durch Komma getrennt. Ohne Eintrag wird die Signatur zwar geprüft, aber nicht,
# wer sie geleistet hat — dann nimmt die Anwendung jede Antwort an, die unter
# dieser Adresse ausgeliefert wird.
VERSAMMLUNG_ZEITSTEMPEL_FINGERABDRUECKE=

# ── Das Geheimnis für abgelegte Zugangsschlüssel ───────────────────────────
# Seit dem 14.08.2026 lassen sich KI-Kette und Zeitstempeldienst **in der
# Anwendung** einrichten (Betreiber → Äussere Dienste). Deren Zugangsschlüssel
# liegen dann in der Datenbank — verschlüsselt mit diesem Wert (AES-256-GCM).
#
# Ohne Eintrag funktioniert alles Übrige, nur **Zugangsschlüssel lassen sich
# nicht in der Anwendung ablegen**: Sie kämen sonst im Klartext in die
# Datenbank, und jede Sicherungskopie trüge sie mit. Die Oberfläche sagt das
# vor dem Ausfüllen, nicht erst beim Speichern.
#
#   openssl rand -hex 32
#
# **Getrennt von der Datenbank sichern.** Liegen Auszug und Geheimnis am selben
# Ort, ist die Verschlüsselung eine Verzierung. Und: Geht das Geheimnis
# verloren, sind die abgelegten Schlüssel nicht mehr lesbar — die Anwendung
# sagt es an der Stufe, und man trägt sie neu ein.
VERSAMMLUNG_GEHEIMNIS=

# ── KI-Unterstützung (FR-58 bis FR-63) ─────────────────────────────────────
#
# **Seit dem 14.08.2026 ist das der Rückfall.** Was unter «Betreiber → Äussere
# Dienste» eingerichtet ist, hat Vorrang; die Werte hier gelten nur, solange
# dort nichts steht. Vermischt wird nie — sonst entstünde eine Kette, deren
# Reihenfolge niemand angeordnet hat.
# Vorgabe: aus. Ohne Eintrag bleibt die Anwendung ohne KI vollständig benutzbar
# — es gibt keinen Ablaufschritt, der eine KI voraussetzt.
#
# **Das Modell ist Ihre Entscheidung, nicht die der Anwendung.** Gesprochen wird
# OpenAI-kompatibel (/chat/completions); damit geht jedes Haus, das diese
# Schnittstelle anbietet: Infomaniak, Mistral, OpenAI, oder ein Modell auf dem
# eigenen Rechner (llama.cpp, Ollama, vLLM).
#
# **Die Kette ist die Ausweichung.** Stufe 1 wird zuerst gefragt; antwortet sie
# nicht (Zeitüberschreitung, nicht erreichbar, 429, 5xx), kommt Stufe 2 dran.
# Ausgewichen wird nur bei Ausfall — nie, weil eine Antwort nicht gefällt. Wer
# keine Ausweichung will, richtet nur Stufe 1 ein.
#
# Der NAME steht später im Nachweis und im Protokollvermerk. Schreiben Sie
# hinein, was ein Leser wissen muss — etwa den Standort.

# Stufe 1 — hier: Infomaniak (Schweiz)
VERSAMMLUNG_KI_1_NAME=Infomaniak (CH)
VERSAMMLUNG_KI_1_URL=https://api.infomaniak.com/2/ai/<produkt>/openai/v1/chat/completions
VERSAMMLUNG_KI_1_MODELL=mistralai/Mistral-Small-4-119B-2603
VERSAMMLUNG_KI_1_SCHLUESSEL=
# Wie lange diese Stufe höchstens braucht, bevor die nächste dran ist (ms).
VERSAMMLUNG_KI_1_GEDULD=12000

# Stufe 2 — hier: Mistral (EU/Frankreich). Beachten Sie, dass damit Inhalte das
# Land verlassen; der Name sollte es sagen.
VERSAMMLUNG_KI_2_NAME=
VERSAMMLUNG_KI_2_URL=
VERSAMMLUNG_KI_2_MODELL=
VERSAMMLUNG_KI_2_SCHLUESSEL=

# Andere Möglichkeiten, gleichwertig eingerichtet:
#   OpenAI:   URL=https://api.openai.com/v1/chat/completions   MODELL=gpt-…
#   Lokal:    URL=http://127.0.0.1:11434/v1/chat/completions   MODELL=…
#             (Ollama; Schlüssel bleibt leer — nichts verlässt das Haus)

# ── Betrieb mit compose.prod.yml ───────────────────────────────────────────
# Der Tag des gebauten Abbilds. Wird von scripts/abbild-bauen.sh gesetzt; von
# Hand nur, um bewusst auf eine frühere Fassung zurückzugehen. Nie `latest` —
# nach einem Neustart liesse sich sonst nicht sagen, welche Fassung lief.
VERSAMMLUNG_TAG=

# Der Name des Abbilds ohne Tag, wenn es aus einer Registry kommt statt aus
# scripts/abbild-bauen.sh (leer: `versammlung`). Dann ist VERSAMMLUNG_TAG der
# Tag in der Registry; abbild-bauen.sh setzt ihn nicht.
VERSAMMLUNG_ABBILD=

# Die Adresse, unter der die Anwendung erreichbar ist, mit Schema. SvelteKit
# weist Formulare ab, deren Herkunft nicht dazu passt; hinter einem Proxy ist
# das sonst die erste Störung nach dem Umzug.
ORIGIN=http://127.0.0.1:3000

# Nur Entwicklungsserver: Namen, unter denen Vite antworten darf, durch Kommas
# getrennt (`server.allowedHosts`). Ohne sie weist Vite jeden fremden `Host`
# mit 403 ab, auch den Namen hinter dem Proxy (docs/dienste.md).
VITE_ERLAUBTE_NAMEN=

# Woran der Anwendungscontainer lauscht. Voreingestellt nur der Wirt, weil
# davor ein Proxy mit TLS gehört. Für das Notebook im Versammlungsraum, das
# sein eigenes WLAN aufspannt: VERSAMMLUNG_BIND=0.0.0.0
VERSAMMLUNG_BIND=127.0.0.1
VERSAMMLUNG_PORT=3000

# ── Übernahme der Stammdaten aus immotool (FR-7) ───────────────────────────
# Vorgabe: aus. Ohne Eintrag erscheint die Wahl auf der Übernahmeseite gar
# nicht; die Übernahme aus einer CSV-Datei und die Erfassung von Hand bleiben
# unverändert. **Keine Laufzeitabhängigkeit** — antwortet immotool nicht, ist
# ausschliesslich diese Übernahme betroffen, nie eine laufende Versammlung.
#
# Der Schlüssel ist derselbe Wert, der in immotool als
# IMMOTOOL_VERSAMMLUNG_EXPORT_TOKEN steht. Erzeugen:
#
#   openssl rand -hex 32
#
# Auf dem Notebook im Versammlungsraum bleibt beides leer: Dort ist immotool
# nicht erreichbar, und übernommen wird bei der Vorbereitung, nicht im Saal.
VERSAMMLUNG_IMMOTOOL_URL=
VERSAMMLUNG_IMMOTOOL_TOKEN=

# ── Mailausgang (PRD §13) ──────────────────────────────────────────────────
# Vorgabe: aus. Ohne Eintrag erscheint der Versandknopf gar nicht; die
# Anwendung erzeugt die Dateien wie bisher, verschickt werden sie über Ihr
# Mailprogramm. Der Versand ist eine Option, kein Weg.
#
# **Verschlüsselt oder gar nicht.** Auf Port 465 von Beginn an, sonst STARTTLS
# — ohne Rückfall. Die Anhänge tragen persönliche Zugangscodes.
#
# **Je Person eine Nachricht mit ihrer eigenen Karte**, nie eine Sammelmail.
VERSAMMLUNG_SMTP_HOST=
VERSAMMLUNG_SMTP_PORT=587
VERSAMMLUNG_SMTP_BENUTZER=
VERSAMMLUNG_SMTP_KENNWORT=
VERSAMMLUNG_SMTP_ABSENDER=
VERSAMMLUNG_SMTP_ABSENDERNAME=
