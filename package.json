{
  "name": "versammlung",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run check:schichten && node scripts/handbuch-bauen.mjs && vite build && node scripts/nachbau-einstieg.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:lesbar": "node scripts/check-svelte-lesbar.mjs",
    "check:schichten": "depcruise --config .dependency-cruiser.cjs src/lib src/routes",
    "check:code": "eslint src scripts e2e tests probe \"*.{js,cjs,ts}\"",
    "check:probe": "tsc -p tsconfig.probe.json --noEmit",
    "check:css": "stylelint \"src/**/*.{css,svelte}\"",
    "check:stil": "node scripts/check-stilvariablen.mjs",
    "check:themenfarben": "node scripts/check-themenfarben.mjs",
    "check:anzeigeart": "node scripts/check-anzeigeart.mjs",
    "check:seitenaufbau": "SEITENAUFBAU_MINDESTENS=5 node scripts/check-seitenaufbau.mjs",
    "check:stroeme": "node scripts/check-stroeme.mjs",
    "check:stromnamen": "node scripts/check-stromnamen.mjs",
    "check:datum": "node scripts/check-datumspruefung.mjs",
    "check:kibindung": "node scripts/check-kibindung.mjs",
    "check:hausklassen": "node scripts/check-hausklassen.mjs",
    "check:meldungen": "node scripts/check-meldungen.mjs",
    "check:personendaten": "node scripts/check-personendaten.mjs",
    "check:absagen": "node scripts/check-absagen.mjs",
    "check:regellese": "node scripts/check-regellese.mjs",
    "check:abzug": "node scripts/check-abzug.mjs",
    "check:haken": "node scripts/check-haken.mjs",
    "check:vorgabeknopf": "node scripts/check-vorgabeknopf.mjs",
    "check:bindziel": "node scripts/check-bindziel.mjs",
    "check:fokusmarke": "node scripts/check-fokusmarke.mjs",
    "check:archivsicht": "node scripts/check-archivsicht.mjs",
    "check:abendbindung": "node scripts/check-abendbindung.mjs",
    "check:kennungen": "node scripts/check-kennungen.mjs",
    "check:kernbindung": "node scripts/check-kernbindung.mjs",
    "check:zustand": "node scripts/check-versammlungszustand.mjs",
    "check:zeitzone": "node scripts/check-zeitzone.mjs",
    "check:suchpfad": "node scripts/check-suchpfad.mjs",
    "check:erfordernisweg": "node scripts/check-erfordernisweg.mjs",
    "check:kopfgewicht": "node scripts/check-kopfgewicht.mjs",
    "check:waechternamen": "node scripts/check-waechternamen.mjs",
    "check:texte": "node scripts/check-texte.mjs",
    "check:umlaute": "node scripts/check-umlaute.mjs",
    "check:anrede": "node scripts/check-anrede.mjs",
    "check:aufraeumen": "node scripts/check-aufraeumen.mjs",
    "check:zeichenzahl": "node scripts/check-zeichenzahl.mjs",
    "check:handbuch": "node scripts/handbuch-bauen.mjs",
    "test": "npm run check:schichten && vitest run",
    "test:db": "VERSAMMLUNG_PRUEFDB=${VERSAMMLUNG_PRUEFDB:-versammlung_pruefung_$$} vitest run --config vitest.config.db.ts",
    "probe:ki": "vitest run --config probe/live.config.ts",
    "test:watch": "vitest",
    "check:reissleine": "node scripts/reissleine-an.mjs",
    "pruefen": "npm run check:reissleine && npm run check:lesbar && npm run check:schichten && npm run check:code && npm run check:probe && npm run check:css && npm run check:stil && npm run check:themenfarben && npm run check:anzeigeart && npm run check:seitenaufbau && npm run check:stroeme && npm run check:stromnamen && npm run check:datum && npm run check:kibindung && npm run check:hausklassen && npm run check:meldungen && npm run check:personendaten && npm run check:absagen && npm run check:regellese && npm run check:abzug && npm run check:haken && npm run check:vorgabeknopf && npm run check:bindziel && npm run check:fokusmarke && npm run check:archivsicht && npm run check:kennungen && npm run check:abendbindung && npm run check:kernbindung && npm run check:zustand && npm run check:zeitzone && npm run check:suchpfad && npm run check:erfordernisweg && npm run check:kopfgewicht && npm run check:vertretungsgrund && npm run check:waechternamen && npm run check:ci && npm run check:texte && npm run check:umlaute && npm run check:anrede && npm run check:aufraeumen && npm run check:zeichenzahl && npm run check:handbuch && npm run check && npm run test && npm run test:db",
    "migrate": "node --experimental-strip-types src/lib/server/migrate.ts",
    "check:vertretungsgrund": "node scripts/check-vertretungsgrund.mjs",
    "check:ci": "node scripts/check-ci-skripte.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.3.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.16",
    "vite-node": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "argon2": "^0.44.0",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.1.2",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.8",
    "qrcode": "^1.5.4"
  }
}
